<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FFXIVSpanishPatcher.App.ViewModels"
        xmlns:views="using:FFXIVSpanishPatcher.App.Views"
        x:Class="FFXIVSpanishPatcher.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.ico"
        Title="{Binding WindowTitle}"
        Width="1280"
        Height="845"
        MinWidth="1200"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        FontFamily="fonts:Inter#Inter">

  <Window.Resources>
    <FontFamily x:Key="UiFont">fonts:Inter#Inter</FontFamily>
    <FontFamily x:Key="DisplayFont">avares://FFXIVSpanishPatcher/Assets/Fonts#Noto Serif</FontFamily>

    <LinearGradientBrush x:Key="AppBackground" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#07101E" Offset="0"/>
      <GradientStop Color="#081426" Offset="0.48"/>
      <GradientStop Color="#06101D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeaderBackground" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#081321" Offset="0"/>
      <GradientStop Color="#07101E" Offset="0.55"/>
      <GradientStop Color="#081426" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Panel" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#111D30" Offset="0"/>
      <GradientStop Color="#0D192B" Offset="0.58"/>
      <GradientStop Color="#0B1728" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelElevated" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#14243A" Offset="0"/>
      <GradientStop Color="#101D31" Offset="0.55"/>
      <GradientStop Color="#0E1A2D" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InsetPanel" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#0A182A" Offset="0"/>
      <GradientStop Color="#091524" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Console" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#071320" Offset="0"/>
      <GradientStop Color="#06111E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="50%,0%" EndPoint="50%,100%">
      <GradientStop Color="#4699FF" Offset="0"/>
      <GradientStop Color="#2F83EB" Offset="0.55"/>
      <GradientStop Color="#2875D8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SecondaryGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#172A45" Offset="0"/>
      <GradientStop Color="#102039" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="HeroGlow"
                         GradientOrigin="92%,8%"
                         Center="92%,8%"
                         RadiusX="88%"
                         RadiusY="150%">
      <GradientStop Color="#313339" Offset="0"/>
      <GradientStop Color="#1B293D" Offset="0.38"/>
      <GradientStop Color="#101D31" Offset="1"/>
    </RadialGradientBrush>
    <!-- Sheen keyframes: same stops, the gradient vector slides from off-left to off-right.
         The animated control must also use a gradient as its resting brush: Avalonia casts that
         value to a gradient when the animation starts or stops, and throws on a solid colour. -->
    <LinearGradientBrush x:Key="InviteSheenStart" StartPoint="-100%,0%" EndPoint="0%,0%">
      <GradientStop Color="#3D8A6A22" Offset="0"/>
      <GradientStop Color="#3D8A6A22" Offset="0.38"/>
      <GradientStop Color="#A6F0BD58" Offset="0.5"/>
      <GradientStop Color="#3D8A6A22" Offset="0.62"/>
      <GradientStop Color="#3D8A6A22" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InviteSheenEnd" StartPoint="100%,0%" EndPoint="200%,0%">
      <GradientStop Color="#3D8A6A22" Offset="0"/>
      <GradientStop Color="#3D8A6A22" Offset="0.38"/>
      <GradientStop Color="#A6F0BD58" Offset="0.5"/>
      <GradientStop Color="#3D8A6A22" Offset="0.62"/>
      <GradientStop Color="#3D8A6A22" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressSheenStart" StartPoint="-100%,0%" EndPoint="0%,0%">
      <GradientStop Color="#3C8DFF" Offset="0"/>
      <GradientStop Color="#3C8DFF" Offset="0.3"/>
      <GradientStop Color="#A6E9FF" Offset="0.5"/>
      <GradientStop Color="#3C8DFF" Offset="0.7"/>
      <GradientStop Color="#3C8DFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ProgressSheenEnd" StartPoint="100%,0%" EndPoint="200%,0%">
      <GradientStop Color="#3C8DFF" Offset="0"/>
      <GradientStop Color="#3C8DFF" Offset="0.3"/>
      <GradientStop Color="#A6E9FF" Offset="0.5"/>
      <GradientStop Color="#3C8DFF" Offset="0.7"/>
      <GradientStop Color="#3C8DFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Line" Color="#29405F"/>
    <SolidColorBrush x:Key="LineSoft" Color="#1D3350"/>
    <SolidColorBrush x:Key="Text" Color="#EFF5FD"/>
    <SolidColorBrush x:Key="Muted" Color="#8EA4BF"/>
    <SolidColorBrush x:Key="Blue" Color="#3C8DFF"/>
    <SolidColorBrush x:Key="Cyan" Color="#6BD8FF"/>
    <SolidColorBrush x:Key="Gold" Color="#F0BD58"/>
    <SolidColorBrush x:Key="Green" Color="#58DFA6"/>
    <SolidColorBrush x:Key="Yellow" Color="#F4CB70"/>
    <SolidColorBrush x:Key="Red" Color="#FF7B82"/>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BoxShadow" Value="0 12 34 0 #42000000"/>
    </Style>
    <Style Selector="Border.card.elevated">
      <Setter Property="Background" Value="{StaticResource PanelElevated}"/>
      <Setter Property="BorderBrush" Value="#324968"/>
      <Setter Property="BoxShadow" Value="0 16 42 0 #52000000"/>
    </Style>
    <Style Selector="Border.inset">
      <Setter Property="Background" Value="{StaticResource InsetPanel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="-0.15"/>
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="-0.2"/>
    </Style>
    <Style Selector="TextBlock.h3">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{StaticResource SecondaryGradient}"/>
      <Setter Property="BorderBrush" Value="#304A6C"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="MaxWidth" Value="Infinity"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="BorderBrush" Value="#5A9CF5"/>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#183B69"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
      <Setter Property="BorderBrush" Value="#72B1FF"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="46"/>
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Opacity" Value="0.42"/>
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="{StaticResource SecondaryGradient}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="46"/>
    </Style>
    <Style Selector="Button.text">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.plugin">
      <Setter Property="Background" Value="{StaticResource InviteSheenStart}"/>
      <Setter Property="BorderBrush" Value="#8AF0BD58"/>
      <Setter Property="Foreground" Value="#FFE9BC"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <!-- Subtle invitation: a gold glint crosses the button every few seconds. -->
      <Style.Animations>
        <Animation Duration="0:0:1.6" DelayBetweenIterations="0:0:3.4" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="Background" Value="{StaticResource InviteSheenStart}"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Background" Value="{StaticResource InviteSheenEnd}"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Button.plugin:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
    </Style>
    <Style Selector="ProgressBar.live">
      <Style.Animations>
        <Animation Duration="0:0:1.4" DelayBetweenIterations="0:0:0.5" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="Foreground" Value="{StaticResource ProgressSheenStart}"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Foreground" Value="{StaticResource ProgressSheenEnd}"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <!-- Check tiles. A tile that does something is a Button and shows its hint in cyan. -->
    <Style Selector="Border.tile">
      <Setter Property="Padding" Value="9,8"/>
      <Setter Property="MinHeight" Value="60"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Background" Value="{StaticResource InsetPanel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.tile">
      <Setter Property="Padding" Value="9,8"/>
      <Setter Property="MinHeight" Value="60"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Background" Value="{StaticResource InsetPanel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineSoft}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Border.tileIcon">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="#4156D69B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="#2A0C3A38"/>
    </Style>
    <Style Selector="Border.tileIcon TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.tileIcon TextBlock.ok">
      <Setter Property="Foreground" Value="{StaticResource Green}"/>
    </Style>
    <Style Selector="Border.tileIcon TextBlock.warn">
      <Setter Property="Foreground" Value="{StaticResource Yellow}"/>
    </Style>
    <Style Selector="Border.tileIcon TextBlock.wait">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style Selector="TextBlock.tileTitle">
      <Setter Property="Foreground" Value="#E1EAF5"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.tileSub">
      <Setter Property="Foreground" Value="#8CA3C0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.tileSub.link">
      <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
    </Style>
    <Style Selector="Button.console">
      <Setter Property="Background" Value="{StaticResource SecondaryGradient}"/>
      <Setter Property="BorderBrush" Value="#2C4668"/>
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="MinHeight" Value="30"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#091523"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#D7E3F2"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="MinHeight" Value="24"/>
    </Style>
    <Style Selector="Expander">
      <Setter Property="Foreground" Value="#C3D2E4"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="FlyoutPresenter">
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Padding" Value="18,24"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="76,*,38" Background="{StaticResource AppBackground}">
    <Border Grid.Row="0"
            Background="{StaticResource HeaderBackground}"
            BorderBrush="{StaticResource Line}"
            BorderThickness="0,0,0,1"
            BoxShadow="0 8 30 0 #22000000"
            Padding="24,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="54"
                  Height="54"
                  Margin="0,0,14,0"
                  ClipToBounds="True"
                  CornerRadius="15"
                  BorderBrush="#4666A0CE"
                  BorderThickness="1"
                  BoxShadow="0 8 22 0 #40125487">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#173252" Offset="0"/>
                <GradientStop Color="#10223D" Offset="0.58"/>
                <GradientStop Color="#0D1B31" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Image Source="/Assets/logo-git.png"
                   Width="82"
                   Height="82"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Classes="h1" Text="FFXIV Spanish Patcher" VerticalAlignment="Center"/>
              <Border Padding="9,4"
                      BorderBrush="#4862BEEB"
                      BorderThickness="1"
                      CornerRadius="7"
                      Background="#28205A77">
                <TextBlock Text="{Binding AppVersionLabel}"
                           Foreground="{StaticResource Cyan}"
                           FontSize="11"
                           FontWeight="Bold"/>
              </Border>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
              <Border Width="13"
                      Height="13"
                      BorderBrush="{StaticResource Gold}"
                      BorderThickness="1"
                      CornerRadius="3"
                      RenderTransformOrigin="50%,50%">
                <Border.RenderTransform>
                  <RotateTransform Angle="45"/>
                </Border.RenderTransform>
              </Border>
              <TextBlock Grid.Column="1" Text="Edición Endwalker"
                         Foreground="{StaticResource Gold}"
                         FontSize="13"
                         FontWeight="SemiBold"/>
              <TextBlock Grid.Column="2"
                         Text="· Traducción en curso sobre ARR, Heavensward, Stormblood y Shadowbringers completos"
                         ToolTip.Tip="Traducción en curso sobre ARR, Heavensward, Stormblood y Shadowbringers completos"
                         TextTrimming="CharacterEllipsis"
                         Foreground="#C8D5E6"
                         FontSize="13"/>
            </Grid>
          </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
          <Border Padding="12,9"
                  BorderBrush="#3456D69B"
                  BorderThickness="1"
                  CornerRadius="10"
                  Background="#2A0C3A38"
                  IsVisible="{Binding IsVersionMatch}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="8" Height="8" CornerRadius="4"
                      Background="{StaticResource Green}"
                      BoxShadow="0 0 10 0 #A056D69B"/>
              <TextBlock Text="FFXIV compatible"
                         Foreground="#AEE6D1"
                         FontSize="11.5"/>
            </StackPanel>
          </Border>
          <Border Padding="12,9"
                  BorderBrush="#55F2C96D"
                  BorderThickness="1"
                  CornerRadius="10"
                  Background="#26976719"
                  IsVisible="{Binding IsVersionWarning}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="8" Height="8" CornerRadius="4"
                      Background="{StaticResource Yellow}"
                      BoxShadow="0 0 10 0 #80F2C96D"/>
              <TextBlock Text="Versión diferente"
                         Foreground="#FFD99A"
                         FontSize="11.5"/>
            </StackPanel>
          </Border>

          <Border Padding="3"
                  BorderBrush="#304766"
                  BorderThickness="1"
                  CornerRadius="11"
                  Background="#8F091524">
            <Grid ColumnDefinitions="Auto,Auto,Auto">
              <Grid Grid.Column="0">
                <Border CornerRadius="8"
                        Background="#26345B86"
                        BorderBrush="#415A79A3"
                        BorderThickness="1"
                        IsVisible="{Binding IsPreparationStage}"/>
                <TextBlock Text="Preparación"
                           Margin="13,8"
                           FontSize="11"
                           Foreground="#EAF3FF"
                           IsVisible="{Binding IsPreparationStage}"/>
                <TextBlock Text="Preparación"
                           Margin="13,8"
                           FontSize="11"
                           Foreground="#7F91A9"
                           IsVisible="{Binding IsPastPreparation}"/>
              </Grid>
              <Grid Grid.Column="1">
                <Border CornerRadius="8"
                        Background="#26345B86"
                        BorderBrush="#415A79A3"
                        BorderThickness="1"
                        IsVisible="{Binding IsGeneratingStage}"/>
                <TextBlock Text="Generando"
                           Margin="13,8"
                           FontSize="11"
                           Foreground="#EAF3FF"
                           IsVisible="{Binding IsGeneratingStage}"/>
                <TextBlock Text="Generando"
                           Margin="13,8"
                           FontSize="11"
                           Foreground="#7F91A9"
                           IsVisible="{Binding IsBeforeGenerating}"/>
                <TextBlock Text="Generando"
                           Margin="13,8"
                           FontSize="11"
                           Foreground="#91B3D5"
                           IsVisible="{Binding IsPastGenerating}"/>
              </Grid>
              <Grid Grid.Column="2">
                <Border CornerRadius="8"
                        Background="#26345B86"
                        BorderBrush="#415A79A3"
                        BorderThickness="1"
                        IsVisible="{Binding IsResultStage}"/>
                <TextBlock Text="Resultado"
                           Margin="13,8"
                           FontSize="11"
                           Foreground="#EAF3FF"
                           IsVisible="{Binding IsResultStage}"/>
                <TextBlock Text="Resultado"
                           Margin="13,8"
                           FontSize="11"
                           Foreground="#7F91A9"
                           IsVisible="{Binding IsPreparationStage}"/>
                <TextBlock Text="Resultado"
                           Margin="13,8"
                           FontSize="11"
                           Foreground="#7F91A9"
                           IsVisible="{Binding IsGeneratingStage}"/>
              </Grid>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="24,14,24,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="1.36*" MinHeight="385"/>
        <RowDefinition Height="12"/>
        <RowDefinition Height="0.64*" MinHeight="130"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" ColumnDefinitions="1.7*,18,1*">
        <Border x:Name="SetupPanel" Grid.Column="0" Classes="card" Padding="18,16">
          <Grid RowDefinitions="Auto,10,Auto,10,*,10,Auto">
              <Grid Grid.Row="0">
                <StackPanel Spacing="5">
                  <TextBlock Text="COMPROBACIÓN PREVIA"
                             Foreground="{StaticResource Cyan}"
                             FontSize="10.5"
                             FontWeight="Bold"
                             LetterSpacing="1.2"/>
                  <TextBlock Classes="h2" Text="{Binding SetupTitle}"/>
                  <TextBlock Text="{Binding SetupLead}" Foreground="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
              </Grid>

              <Grid Grid.Row="2" ColumnDefinitions="*,7,*,7,*,7,*">
                <Button Grid.Column="0"
                        Classes="tile"
                        Command="{Binding BrowseCommand}"
                        ToolTip.Tip="{Binding GamePath}">
                  <Grid x:Name="GameCheckContent" ColumnDefinitions="24,*" Height="32" VerticalAlignment="Center">
                    <Border Classes="tileIcon">
                      <Grid>
                        <TextBlock Classes="ok" Text="✓" IsVisible="{Binding IsGamePathValid}"/>
                        <TextBlock Classes="warn" Text="!" IsVisible="{Binding !IsGamePathValid}"/>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                      <TextBlock Classes="tileTitle" Text="{Binding GameCheckTitle}"/>
                      <TextBlock Classes="tileSub link" Text="{Binding GameCheckSubtitle}"/>
                    </StackPanel>
                  </Grid>
                </Button>

                <Border Grid.Column="2" Classes="tile" ToolTip.Tip="{Binding VersionCheckTooltip}">
                  <Grid x:Name="VersionCheckContent" ColumnDefinitions="24,*" Height="32" VerticalAlignment="Center">
                    <Border Classes="tileIcon">
                      <Grid>
                        <TextBlock Classes="ok" Text="✓" IsVisible="{Binding IsVersionMatch}"/>
                        <TextBlock Classes="warn" Text="!" IsVisible="{Binding IsVersionWarning}"/>
                        <TextBlock Classes="wait" Text="?" IsVisible="{Binding IsVersionUnknown}"/>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                      <TextBlock Classes="tileTitle" Text="{Binding VersionCheckTitle}"/>
                      <TextBlock Classes="tileSub" Text="{Binding VersionCheckSubtitle}"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Grid.Column="4" Classes="tile">
                  <Grid x:Name="CorpusCheckContent" ColumnDefinitions="24,*" Height="32" VerticalAlignment="Center">
                    <Border Classes="tileIcon">
                      <Grid>
                        <TextBlock Classes="ok" Text="✓" IsVisible="{Binding TranslationsReady}"/>
                        <TextBlock Classes="wait" Text="…" IsVisible="{Binding !TranslationsReady}"/>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                      <TextBlock Classes="tileTitle" Text="{Binding CorpusCheckTitle}"/>
                      <TextBlock Classes="tileSub" Text="{Binding CorpusCheckSubtitle}"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Only a button while there is something to review. -->
                <Button Grid.Column="6"
                        Classes="tile"
                        Command="{Binding ReviewDalamudCommand}"
                        IsHitTestVisible="{Binding IsDalamudWarning}"
                        Focusable="{Binding IsDalamudWarning}">
                  <Grid x:Name="DalamudCheckContent" ColumnDefinitions="24,*" Height="32" VerticalAlignment="Center">
                    <Border Classes="tileIcon">
                      <Grid>
                        <TextBlock Classes="ok" Text="✓" IsVisible="{Binding IsDalamudOk}"/>
                        <TextBlock Classes="warn" Text="!" IsVisible="{Binding IsDalamudWarning}"/>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                      <TextBlock Classes="tileTitle" Text="{Binding DalamudCheckTitle}"/>
                      <TextBlock Classes="tileSub" Classes.link="{Binding IsDalamudWarning}"
                                 Text="{Binding DalamudCheckSubtitle}"/>
                    </StackPanel>
                  </Grid>
                </Button>
              </Grid>

              <Border x:Name="ModContentPanel"
                      Grid.Row="4"
                      Classes="inset"
                      ClipToBounds="True"
                      Padding="12,10">
                <ScrollViewer x:Name="ModContentScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Contenido del mod"
                                 Foreground="#E2EBF6"
                                 FontSize="13"
                                 FontWeight="SemiBold"/>
                      <TextBlock Text="Configuración recomendada. Incluye toda traducción aprobada disponible."
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="{StaticResource Muted}"
                                 FontSize="11.5"
                                 IsVisible="{Binding IsAdvancedClosed}"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="9,5"
                            CornerRadius="7"
                            Background="#233C6FA9"
                            BorderBrush="#333C78B3"
                            BorderThickness="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Top">
                      <TextBlock Text="{Binding CategorySummary}"
                                 Foreground="#BDD8F5"
                                 FontSize="11"/>
                    </Border>
                  </Grid>

                  <Border Height="1" Background="#253954"/>

                  <Border IsVisible="{Binding IsVersionWarning}"
                          Padding="10,7"
                          CornerRadius="7"
                          Background="#26976719"
                          BorderBrush="#55F2C96D"
                          BorderThickness="1">
                    <TextBlock Foreground="#FFD09A"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Text="La instalación usa una versión distinta. Al generar se pedirá confirmación y se aplicará best effort, omitiendo contenido inexistente."/>
                  </Border>

                  <Button Classes="text"
                          HorizontalAlignment="Left"
                          Command="{Binding ToggleAdvancedCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="▸" IsVisible="{Binding IsAdvancedClosed}" FontSize="11"/>
                      <TextBlock Text="▾" IsVisible="{Binding IsAdvancedOpen}" FontSize="11"/>
                      <TextBlock Text="Opciones avanzadas y categorías" Foreground="#C3D2E4" FontSize="12"/>
                    </StackPanel>
                  </Button>
                  <StackPanel x:Name="AdvancedPanel"
                              IsVisible="{Binding IsAdvancedOpen}"
                              Spacing="5">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Spacing="1">
                          <TextBlock Text="Categorías activadas en primera importación de Penumbra" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                          <TextBlock Text="El paquete siempre incluye traducción completa." Foreground="#8CA3C0" FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="text" Content="Todas"
                                Command="{Binding SelectAllCategoriesCommand}"/>
                        <Button Grid.Column="2" Classes="text" Content="Ninguna"
                                Command="{Binding SelectNoCategoriesCommand}" Margin="8,0,0,0"/>
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Columns="5"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:CategoryViewModel">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      IsEnabled="{Binding IsEnabled}"
                                      ToolTip.Tip="{Binding Tooltip}"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      FontSize="11">
                              <StackPanel Spacing="0">
                                <TextBlock Text="{Binding Label}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Count, StringFormat='({0:N0})'}"
                                           Foreground="#8CA3C0"
                                           FontSize="10.5"/>
                              </StackPanel>
                            </CheckBox>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock IsVisible="{Binding ShowCategorySelectionError}"
                                 Text="Selecciona al menos una categoría para generar el mod."
                                 Foreground="#FFD09A"
                                 FontSize="12"/>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
              </Border>

              <Grid Grid.Row="6" ColumnDefinitions="2.1*,10,1*">
                <Button x:Name="PrimaryAction"
                        Grid.Column="0"
                        Classes="primary"
                        Content="Crear traducción para Penumbra"
                        Command="{Binding GenerateModCommand}"/>
                <Button Grid.Column="2"
                        Classes="secondary"
                        Content="Abrir carpeta de salida"
                        Command="{Binding OpenOutputFolderCommand}"/>
              </Grid>
          </Grid>
        </Border>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="1.05*" MinHeight="215"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="0.95*" MinHeight="160"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0"
                  Classes="card elevated"
                  Background="{StaticResource HeroGlow}"
                  ClipToBounds="True"
                  Padding="20,16">
            <Grid>
              <Canvas IsHitTestVisible="False">
                <Ellipse Width="145"
                         Height="145"
                         Canvas.Left="325"
                         Canvas.Top="-65"
                         Stroke="#268F7742"
                         StrokeThickness="1"/>
                <Ellipse Width="88"
                         Height="88"
                         Canvas.Left="353"
                         Canvas.Top="-37"
                         Stroke="#1577C7F5"
                         StrokeThickness="1"/>
              </Canvas>
              <StackPanel VerticalAlignment="Center" Spacing="7">
                <Grid ColumnDefinitions="Auto,*">
                  <Border VerticalAlignment="Center"
                          Padding="10,5"
                          CornerRadius="8"
                          Background="#247B5D20"
                          BorderBrush="#5A9E7B32"
                          BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <Border Width="10" Height="10" CornerRadius="3"
                              BorderBrush="{StaticResource Gold}" BorderThickness="1"
                              RenderTransformOrigin="50%,50%">
                        <Border.RenderTransform>
                          <RotateTransform Angle="45"/>
                        </Border.RenderTransform>
                      </Border>
                      <TextBlock Text="HITO DE TRADUCCIÓN" Foreground="{StaticResource Gold}"
                                 FontSize="10.5" FontWeight="Bold"/>
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                              HorizontalAlignment="Right">
                    <Border Width="36" Height="36" Padding="3" CornerRadius="9"
                            Background="#24121E30" BorderBrush="#4A8EA4BF" BorderThickness="1">
                      <Image x:Name="MilestoneArrIcon" Source="/Assets/arr-icon.png"
                             ToolTip.Tip="A Realm Reborn" Stretch="Uniform"/>
                    </Border>
                    <Border Width="36" Height="36" Padding="3" CornerRadius="9"
                            Background="#24121E30" BorderBrush="#4AF0BD58" BorderThickness="1">
                      <Image x:Name="MilestoneHeavenswardIcon" Source="/Assets/hw-icon.png"
                             ToolTip.Tip="Heavensward" Stretch="Uniform"/>
                    </Border>
                    <Border Width="36" Height="36" Padding="3" CornerRadius="9"
                            Background="#24121E30" BorderBrush="#4AD46A4A" BorderThickness="1">
                      <Image x:Name="MilestoneStormbloodIcon" Source="/Assets/stb-icon.png"
                             ToolTip.Tip="Stormblood" Stretch="Uniform"/>
                    </Border>
                    <Border Width="36" Height="36" Padding="3" CornerRadius="9"
                            Background="#24121E30" BorderBrush="#4A8E6FBF" BorderThickness="1">
                      <Image x:Name="MilestoneShadowbringersIcon" Source="/Assets/shb-icon.png"
                             ToolTip.Tip="Shadowbringers" Stretch="Uniform"/>
                    </Border>
                    <Border Width="36" Height="36" Padding="3" CornerRadius="9"
                            Background="#24121E30" BorderBrush="#4A9DB4E8" BorderThickness="1">
                      <Image x:Name="MilestoneEndwalkerIcon" Source="/Assets/ew-icon.png"
                             ToolTip.Tip="Endwalker" Stretch="Uniform"/>
                    </Border>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="MilestoneTitle" Text="Empieza Endwalker."
                           Foreground="{StaticResource Text}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="27"
                           FontWeight="Normal"
                           LetterSpacing="-0.3"/>
                <TextBlock Text="Con Shadowbringers ya completo, arranca la traducción de Endwalker. Y la traducción estrena plugin de Dalamud: se instala y se actualiza sola desde dentro del juego."
                           Foreground="{StaticResource Muted}"
                           FontSize="12"
                           LineHeight="17"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           MaxWidth="430"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button x:Name="PluginInvite"
                          Classes="plugin"
                          IsVisible="{Binding IsPluginInviteVisible}"
                          Command="{Binding InvitePluginCommand}"
                          ToolTip.Tip="Instala el plugin en Dalamud. Se pide confirmación antes de cambiar nada.">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="9" Height="9" CornerRadius="2"
                              Background="#66F0BD58"
                              BorderBrush="{StaticResource Gold}" BorderThickness="1"
                              VerticalAlignment="Center"
                              RenderTransformOrigin="50%,50%">
                        <Border.RenderTransform>
                          <RotateTransform Angle="45"/>
                        </Border.RenderTransform>
                      </Border>
                      <TextBlock Text="Pásate al plugin de Dalamud" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button Classes="text" VerticalAlignment="Center"
                          Content="Ver hitos de traducción"
                          Command="{Binding ShowMilestonesCommand}"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="2" Classes="card elevated" Padding="18,15">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Grid.Row="0" Classes="h3" Text="Estado de generación"/>

              <Grid Grid.Row="1">
                <StackPanel IsVisible="{Binding IsPreparationStage}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                  <Border Width="44" Height="44" CornerRadius="22"
                          BorderBrush="#5556D69B" BorderThickness="1"
                          BoxShadow="0 0 22 0 #3856D69B"
                          Background="#2A0C3A38"
                          IsVisible="{Binding IsReadyToGenerate}">
                    <TextBlock Text="✓" Foreground="{StaticResource Green}" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Border Width="44" Height="44" CornerRadius="22"
                          BorderBrush="#55F2C96D" BorderThickness="1" Background="#289B701F"
                          IsVisible="{Binding !IsReadyToGenerate}">
                    <TextBlock Text="!" Foreground="{StaticResource Yellow}" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Classes="h3" Text="{Binding ReadyHeadline}" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding ReadyDetail}" HorizontalAlignment="Center"
                             Foreground="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsGeneratingStage}"
                            VerticalAlignment="Center"
                            Spacing="10">
                  <TextBlock Classes="h3" Text="Generando el mod"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding ProgressText}" Foreground="#B4C5DA" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat='{}{0} %'}"
                               Foreground="{StaticResource Cyan}" FontSize="12" FontWeight="SemiBold"/>
                  </Grid>
                  <ProgressBar x:Name="GenerationProgress"
                               Classes.live="{Binding IsGeneratingStage}"
                               Value="{Binding ProgressPercent, Mode=OneWay}" Minimum="0" Maximum="100"
                               Height="8" Foreground="{StaticResource ProgressSheenStart}"
                               Background="#152A4568">
                    <ProgressBar.Transitions>
                      <Transitions>
                        <DoubleTransition Property="Value" Duration="0:0:0.5" Easing="CubicEaseOut"/>
                      </Transitions>
                    </ProgressBar.Transitions>
                  </ProgressBar>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsResultStage}" Spacing="8" VerticalAlignment="Center">
                  <Grid ColumnDefinitions="42,*">
                    <Border Width="38" Height="38" CornerRadius="19"
                            BorderBrush="#4D56D69B" BorderThickness="1" Background="#2556D69B"
                            IsVisible="{Binding IsResultSuccess}">
                      <TextBlock Text="✓" Foreground="{StaticResource Green}" FontSize="19"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Width="38" Height="38" CornerRadius="19"
                            BorderBrush="#4DF2C96D" BorderThickness="1" Background="#25F2C96D"
                            IsVisible="{Binding IsResultPartial}">
                      <TextBlock Text="!" Foreground="{StaticResource Yellow}" FontSize="19"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Width="38" Height="38" CornerRadius="19"
                            BorderBrush="#4DFF7B82" BorderThickness="1" Background="#25FF7B82"
                            IsVisible="{Binding IsResultError}">
                      <TextBlock Text="×" Foreground="{StaticResource Red}" FontSize="21"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="h3" Text="{Binding ResultTitle}"/>
                      <TextBlock Text="{Binding ResultSubtitle}" Foreground="{StaticResource Muted}"
                                 FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*,*,*" IsVisible="{Binding IsUsableResult}">
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding ResultApplied}" Foreground="{StaticResource Text}"
                                 FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      <TextBlock Text="Aplicadas" Foreground="{StaticResource Muted}" FontSize="10.5"
                                 HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding ResultPages}" Foreground="{StaticResource Text}"
                                 FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      <TextBlock Text="Páginas" Foreground="{StaticResource Muted}" FontSize="10.5"
                                 HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{Binding ResultOmitted}" Foreground="{StaticResource Yellow}"
                                 FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      <TextBlock Text="Omitidas" Foreground="{StaticResource Muted}" FontSize="10.5"
                                 HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                      <TextBlock Text="{Binding ResultFailures}" Foreground="{StaticResource Green}"
                                 FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      <TextBlock Text="Fallos" Foreground="{StaticResource Muted}" FontSize="10.5"
                                 HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock IsVisible="{Binding IsUsableResult}"
                             Text="Siguiente paso: importa el archivo en Penumbra y reinicia el juego."
                             Foreground="#B4C5DA" FontSize="11.5" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Border x:Name="ConsolePanel"
              Grid.Row="2"
              Classes="card elevated"
              ClipToBounds="True"
              Padding="15,12">
        <Grid RowDefinitions="Auto,8,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Classes="h3" Text="Consola"/>
              <TextBlock Text="Selección continua con ratón, Ctrl+A y Ctrl+C."
                         Foreground="{StaticResource Muted}" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
              <Button Classes="console" Content="Seleccionar todo" Click="SelectConsoleAll_OnClick"/>
              <Button Classes="console" Content="Copiar log" Command="{Binding CopyLogCommand}"/>
              <Button Classes="console" Content="Limpiar" Command="{Binding ClearConsoleCommand}"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="2"
                  Background="{StaticResource Console}"
                  CornerRadius="9"
                  BorderBrush="#263C59"
                  BorderThickness="1"
                  BoxShadow="0 8 24 0 #35000000"
                  Padding="12,9">
            <views:ConsoleLogTextBlock Name="ConsoleText"
                                       Lines="{Binding Console}"
                                       Background="Transparent"
                                       FontFamily="Cascadia Mono,Consolas,monospace"
                                       FontSize="12.5"
                                       WordWrap="False"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"
                                       Foreground="#B7C6D9"/>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{StaticResource HeaderBackground}"
            BorderBrush="{StaticResource Line}"
            BorderThickness="0,1,0,0"
            Padding="24,0">
      <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
        <TextBlock Text="{Binding OutputFolder, StringFormat='Salida: {0}'}"
                   Foreground="{StaticResource Muted}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1"
                   Text="{Binding CorpusFooterLabel, StringFormat='Corpus {0}'}"
                   Foreground="{StaticResource Muted}"
                   FontSize="11"
                   Margin="18,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
          <Border Width="7" Height="7" CornerRadius="4" Background="{StaticResource Green}"/>
          <TextBlock Text="{Binding StatusText}" Foreground="#C4D4E7" FontSize="11" FontWeight="SemiBold"/>
          <Button Classes="text" Content="Aviso legal" Margin="10,0,0,0">
            <Button.Flyout>
              <Flyout Placement="TopEdgeAlignedRight">
                <StackPanel Width="440" Spacing="10">
                  <TextBlock Text="Aviso legal" Foreground="{StaticResource Text}"
                             FontWeight="SemiBold" FontSize="15"/>
                  <SelectableTextBlock Text="{Binding LegalNoticeText}"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       SelectionBrush="{StaticResource Blue}"/>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.RowSpan="3" Background="#D9050B14" IsVisible="{Binding IsMilestoneOpen}"
          PointerPressed="MilestoneBackdrop_OnPointerPressed">
      <Border Width="760" MaxHeight="660" Classes="card elevated" Padding="23"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,12,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Hitos de traducción" Classes="h2"/>
              <TextBlock Text="Contenido incluido en data/translation-milestones.md"
                         Foreground="{StaticResource Muted}" FontSize="11"/>
            </StackPanel>
            <Button x:Name="MilestoneClose" Grid.Column="1" Classes="secondary" Content="Cerrar (Esc)"
                    Command="{Binding CloseMilestonesCommand}"/>
          </Grid>
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ContentControl Name="MilestoneContentHost"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.RowSpan="3" Background="#D9050B14" IsVisible="{Binding IsModalOpen}">
      <Border Width="620" Classes="card elevated" Padding="27"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="13">
          <Border Width="45" Height="45" CornerRadius="23"
                  BorderBrush="#55F2C96D" BorderThickness="1" Background="#289B701F"
                  HorizontalAlignment="Left">
            <TextBlock Text="!" Foreground="{StaticResource Yellow}" FontSize="21"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{Binding ModalTitle}" Classes="h2" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ModalBody}" Foreground="#C8D5E6" FontSize="13.5"
                     TextWrapping="Wrap" LineHeight="19"/>
          <Border Padding="14,11" CornerRadius="9" Background="#101F35"
                  BorderBrush="{StaticResource Line}" BorderThickness="1">
            <TextBlock Text="{Binding ModalExplanation}" Foreground="#DCE8F7"
                       FontSize="13" TextWrapping="Wrap" LineHeight="18"/>
          </Border>
          <TextBlock Text="{Binding ModalNote}" Foreground="{StaticResource Muted}"
                     FontSize="11.5" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="*,10,*" Margin="0,4,0,0">
            <Button x:Name="ModalSecondary" Grid.Column="0" Classes="secondary"
                    Content="{Binding ModalSecondaryText}"
                    Command="{Binding DismissModalCommand}"/>
            <Button Grid.Column="2" Classes="primary"
                    Content="{Binding ModalPrimaryText}"
                    Command="{Binding AcceptModalCommand}"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
